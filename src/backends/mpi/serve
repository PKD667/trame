#!/usr/bin/env python3
"""serve [--workers N,N,...] -- PROGRAM [ARGS...]: run a long-lived program built for this backend, one trame host per machine of the job
(NIX_DEPLOY_HOSTFILE, through nixsci.lab.mpi) or this machine alone, and stay in the foreground (src/backends/README.md,
Serve). Unlike `launch`, nothing is collected: the command is replaced by mpirun, which ends with the program.

Hosts, workers and ranks are placed as `launch` does (placement.py): each host gets the workers it declares, and
`trame::workers(h)` answers from --workers, TRAME_WORKERS, the hostfile or the machine's cores. stdin reaches the leader of host 0, the last rank of that host, not rank 0, which is a
worker (`mpirun --stdin`). Every rank's stdout and stderr reach this command's, unordered between ranks: a program that
talks over its stdout writes it from the leader only."""

from __future__ import annotations

import os
import sys

from placement import NoTopology, Usage, place


def usage(msg: str) -> None:
    sys.exit(print(f"serve: {msg}\nusage: serve [--workers N,N,...] -- PROGRAM [ARGS...]", file=sys.stderr) or 2)


def main(argv: list[str]) -> None:
    if "--" not in argv:
        usage("no program")
    k = argv.index("--")
    opts, program = argv[:k], argv[k + 1:]
    workers = None
    if opts and opts[0] == "--workers" and len(opts) == 2:
        workers = opts[1]
    elif opts:
        usage(f"unknown option {opts[0]!r}")
    if not program:
        usage("no program")
    try:
        pl = place(program, 1, workers, "none")
    except NoTopology:
        usage("the program launched no topology")
    except Usage as e:
        usage(str(e))
    os.environ.update(pl.env)
    cmd = pl.cmd + ["--stdin", str(pl.ranks[0] - 1)]
    os.execvp(cmd[0], cmd + program)


if __name__ == "__main__":
    main(sys.argv[1:])
