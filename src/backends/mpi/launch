#!/usr/bin/env python3
"""launch [--split S] [--bind B] [--timeout T] --out DIR -- PROGRAM [ARGS...]: run a trame program built for this
backend as H trame hosts, H = machines x S, and write what each host printed (src/backends/README.md, Launch).

Machines are the job's (NIX_DEPLOY_HOSTFILE, through nixsci.lab.mpi), or this machine alone. Each host is one
shared-memory node, or S groups of one node's ranks (TRAME_MPI_NODE_RANKS). The ranks a host needs are asked of the
program first: TRAME_PROBE=ranks on one rank, as host 0 of H (imp.rs). Every rank runs under GNU time.

DIR/host<h>.out   host h's stdout: its ranks' lines in rank order, consecutive duplicates collapsed (a refusal
                  prints once per rank)
DIR/host<h>.err   host h's stderr, the same way, tags removed
DIR/cpu.tsv       host, rank, machine, user_s, sys_s, wall_s: one row per rank
DIR/config.txt    the MPI setup: MCA files, mpirun's version, MCA variables, the command line
Exit status: mpirun's, 124 when the timeout ended it, 2 for a usage error, 3 when
the program launched no topology: it ran once, on one rank, exited 0, and that run is host0.out and host0.err."""

from __future__ import annotations

import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

from nixsci.lab import mpi

TAG = re.compile(r"^\[\d+,(\d+)\]<(stdout|stderr)>: ?(.*)$")  # mpirun --output tag; 5 writes a space after the colon
WRAP = 'echo "HOST $(uname -n)" 1>&2; exec time -f "CPU %U %S %e" "$@"'


def usage(msg: str) -> None:
    sys.exit(print(f"launch: {msg}\n{__doc__.splitlines()[0]}", file=sys.stderr) or 2)


class NoTopology(Exception):
    """The probe run ended without asking for ranks: the program launches no topology, and that run was all of it."""

    def __init__(self, p: subprocess.CompletedProcess):
        self.p = p


def ranks_of(program: list[str], hosts: int) -> int:
    # The count is written to a file (TRAME_PROBE_OUT, imp.rs), not to stdout, which a test harness captures.
    with tempfile.TemporaryDirectory() as d:
        probe = Path(d) / "ranks"
        env = {**os.environ, "TRAME_PROBE": "ranks", "TRAME_PROBE_HOSTS": str(hosts), "TRAME_PROBE_OUT": str(probe)}
        p = subprocess.run(["mpirun", "--oversubscribe", "-n", "1", "-x", "TRAME_PROBE", "-x", "TRAME_PROBE_HOSTS",
                            "-x", "TRAME_PROBE_OUT", *program], capture_output=True, text=True, env=env)
        text = probe.read_text() if probe.exists() else ""
    m = re.search(r"^trame-ranks (\d+)$", text, re.M)
    if not m and p.returncode == 0:
        raise NoTopology(p)
    if not m:
        sys.stderr.write(p.stdout + p.stderr)
        usage("the program did not report its rank count (is it built for this backend?)")
    return int(m.group(1))


def collapse(lines: list[str]) -> str:
    return "".join(x + "\n" for i, x in enumerate(lines) if i == 0 or x != lines[i - 1])


def main(argv: list[str]) -> int:
    split, bind, timeout, out = 1, "none", None, None
    if "--" not in argv:
        usage("no program")
    k = argv.index("--")
    opts, program = argv[:k], argv[k + 1:]
    it = iter(opts)
    for a in it:
        if a == "--split":
            split = int(next(it))
        elif a == "--bind":
            bind = next(it)
        elif a == "--timeout":
            timeout = float(next(it))
        elif a == "--out":
            out = Path(next(it))
        else:
            usage(f"unknown option {a!r}")
    if out is None or not program or split < 1:
        usage("--out DIR and a program are required, and S >= 1")
    out.mkdir(parents=True, exist_ok=True)
    machines = max(1, len(mpi.hosts()))
    hosts = machines * split
    try:
        ranks = ranks_of(program, hosts)
    except NoTopology as e:
        (out / "host0.out").write_text(e.p.stdout)
        (out / "host0.err").write_text(e.p.stderr)
        return 3
    env, export = dict(os.environ), []
    env.pop("TRAME_MPI_NODE_RANKS", None)
    if split > 1:
        env["TRAME_MPI_NODE_RANKS"] = str(ranks)
        export = ["TRAME_MPI_NODE_RANKS"]
    cmd = mpi.command(ranks * hosts, per_node=ranks * split, bind=bind, export=export)
    cmd += ["--output", "tag", "sh", "-c", WRAP, "sh", *program]
    home = Path(os.environ.get("HOME", "/nonexistent"))
    config = [f"# {p}\n{p.read_text() if p.is_file() else ''}" for p in (home / ".openmpi/mca-params.conf", home / ".prte/mca-params.conf")]
    config += [subprocess.run(["mpirun", "--version"], capture_output=True, text=True).stdout.splitlines()[0]]
    config += [f"{n}={v}" for n, v in sorted(os.environ.items()) if n.startswith(("OMPI_MCA_", "PRTE_MCA_"))]
    config += [f"argv {shlex.join(cmd)}"]
    (out / "config.txt").write_text("\n".join(config) + "\n")
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=timeout)
        rc, stdout, stderr = p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired as e:
        rc = 124
        stdout = (e.stdout or b"").decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
        stderr = (e.stderr or b"").decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
    per: dict[tuple[int, str], list[str]] = {}
    cpu: dict[int, dict] = {}
    untagged = []
    for text in (stdout + "\n" + stderr).split("\n"):
        m = TAG.match(text)
        if not m:
            if text:
                untagged.append(text)
            continue
        rank, stream, body = int(m.group(1)), m.group(2), m.group(3)
        if stream == "stderr" and body.startswith("HOST "):
            cpu.setdefault(rank, {})["machine"] = body[5:].strip()
        elif stream == "stderr" and body.startswith("CPU "):
            u, s, w = body[4:].split()
            cpu.setdefault(rank, {}).update(user_s=u, sys_s=s, wall_s=w)
        else:
            per.setdefault((rank, stream), []).append(body)
    for h in range(hosts):
        for stream, ext in (("stdout", "out"), ("stderr", "err")):
            lines = [x for r in range(h * ranks, (h + 1) * ranks) for x in per.get((r, stream), [])]
            text = collapse(lines)
            if stream == "stderr" and h == 0 and untagged:
                text = "".join(x + "\n" for x in untagged) + text
            (out / f"host{h}.{ext}").write_text(text)
    rows = ["host\trank\tmachine\tuser_s\tsys_s\twall_s"]
    for r in sorted(cpu):
        c = cpu[r]
        rows.append(f"{r // ranks}\t{r}\t{c.get('machine', '')}\t{c.get('user_s', '')}\t{c.get('sys_s', '')}\t{c.get('wall_s', '')}")
    (out / "cpu.tsv").write_text("\n".join(rows) + "\n")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
