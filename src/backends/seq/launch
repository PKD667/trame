#!/usr/bin/env bash
# launch [--split S] [--workers N] [--bind B] [--timeout T] --out DIR -- PROGRAM [ARGS...]: run a program built for this backend
# as one trame host, one process (src/backends/README.md, Launch). seq has one host: S must be 1, and a job of
# several machines is refused. --workers N is what `trame::workers(HostId(0))` answers (TRAME_WORKERS), by default
# the usable cores (nproc). --bind is accepted and ignored.
set -u
split=1 timeout="" out="" workers=""
while [[ $# -gt 0 && $1 != -- ]]; do
  case $1 in
    --split) split=$2; shift 2 ;;
    --workers) workers=$2; shift 2 ;;
    --bind) shift 2 ;;
    --timeout) timeout=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    *) echo "launch: unknown option $1" >&2; exit 2 ;;
  esac
done
[[ $# -gt 1 && -n $out ]] || { echo "launch: --out DIR and a program are required" >&2; exit 2; }
shift
[[ $split == 1 ]] || { echo "launch: this backend runs one host; --split $split" >&2; exit 2; }
if [[ -n ${NIX_DEPLOY_HOSTFILE:-} ]] && (( $(grep -c . "$NIX_DEPLOY_HOSTFILE") > 1 )); then
  echo "launch: this backend runs one host; the job has several machines" >&2; exit 2
fi
[[ -z $workers || $workers =~ ^[1-9][0-9]*$ ]] || { echo "launch: this backend runs one host; --workers $workers" >&2; exit 2; }
export TRAME_WORKERS=${workers:-$(nproc)}
# The debug dump (docs/debug.md): its files land in the run's --out directory when the program was
# built with --cfg debug_dump.
export TRAME_DUMP_DIR=${TRAME_DUMP_DIR:-"$out"}
mkdir -p "$out"
echo "argv $*" > "$out/config.txt"
t=$(mktemp)
rc=0
if [[ -n $timeout ]]; then
  timeout -k 5 "$timeout" time -o "$t" -f "%U %S %e" "$@" >"$out/host0.out" 2>"$out/host0.err" || rc=$?
else
  time -o "$t" -f "%U %S %e" "$@" >"$out/host0.out" 2>"$out/host0.err" || rc=$?
fi
read -r u s w < <(tail -1 "$t") || true
printf 'host\trank\tmachine\tuser_s\tsys_s\twall_s\n0\t0\t%s\t%s\t%s\t%s\n' "$(uname -n)" "${u:-}" "${s:-}" "${w:-}" > "$out/cpu.tsv"
rm -f "$t"
exit "$rc"
