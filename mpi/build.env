# How to build and launch the `mpi` backend. Sourced by build/serve.sh and trame/bench.sh, which
# find it by NAME rather than by directory, so a backend's name and its module name may differ.
NAME=mpi
# The cargo feature to enable. `nerve` forwards it to this crate under the same name, so it
# serves `-p nerve` and `-p trame` alike. One transport per binary.
FEATURES=mpi
# The launcher, and the flag it takes the process count under. A backend with its own runtime
# supplies its own here rather than being assumed to speak mpirun.
LAUNCH=mpirun
LAUNCH_RANKS=-n
