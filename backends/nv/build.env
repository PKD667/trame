# How to build and launch the `nv` backend. See trame/backends/mpi/build.env for what each name means,
# and read the two differences here: this backend is not launched by `mpirun`, and its rank count
# is a warp count.
NAME=nv
# The cargo feature, forwarded by `nerve` under the same name. Without `cuda` it builds the host
# model of a warp: an ordinary `cargo test -p trame --features nv` runs the lane
# surface with no GPU and no MPI.
FEATURES=trame/nv
# A device launch is not a process launch. `trame/backends/nv/cargo` builds the kernel and the
# host driver starts it, so what starts a job here is that subcommand and the count is the number
# of warps.
#
# `bench.sh` invokes `$LAUNCH $LAUNCH_RANKS $RANKS <binary>`, and this backend declares no bench
# experiments yet — a process-shaped measurement is not the measurement a warp transport wants.
# So `trame/bench.sh nv` fails at its example build, which is the honest failure: there is
# nothing here to measure yet, and naming a launcher that has no such interface would hide it.
LAUNCH=cargo-nv
LAUNCH_RANKS=--warps
