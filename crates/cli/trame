#!/usr/bin/env python3
"""trame: build a trame program for a backend, and run it through that backend's launch.

  trame backends                                   the backends of this tree
  trame build [--backend NAME] [--check] [CARGO ARGS]
  trame run   [--backend NAME] [--split S] [--bind B] [--timeout T] [--out DIR] PROGRAM [-- ARGS]

A backend is a directory of src/backends/ with a `launch` (src/backends/README.md, Launch). It is a build choice (one per
build), so `build` and `run` take the same --backend. Without one, TRAME_BACKEND names it; failing that, the only backend
of the tree; with several the choice is yours and `trame` says which exist. Nothing here knows how a backend starts its hosts:
`run` hands the program to `launch`, which sizes the job (the rank count is asked of the program), starts the hosts, and
writes what each printed; `run` prints host 0's stdout first, then the others', and exits with the launch's status.
Hosts come from the job (nixsci sets NIX_DEPLOY_HOSTFILE), or this machine alone.

Environment: TRAME_BACKENDS (a directory of <name>/launch; the packaged CLI sets it, otherwise src/backends/ of this tree),
TRAME_BACKEND (the default backend), TRAME_TOOLCHAIN (the driver's rustc, for --check), CARGO_TARGET_DIR."""
import os
import subprocess
import sys
import tempfile
from pathlib import Path


def die(msg):
    sys.exit(f"trame: {msg}")


def backends_dir():
    return Path(os.environ.get("TRAME_BACKENDS") or Path(__file__).resolve().parents[2] / "src" / "backends")


def backends():
    d = backends_dir()
    return sorted(p.name for p in d.iterdir() if (p / "launch").exists()) if d.is_dir() else []


def choose(name):
    names = backends()
    name = name or os.environ.get("TRAME_BACKEND") or (names[0] if len(names) == 1 else None)
    if name is None:
        die(f"choose a backend: --backend NAME, one of: {' '.join(names) or '(none found in ' + str(backends_dir()) + ')'}")
    if name not in names:
        die(f"no backend {name!r}; the backends are: {' '.join(names)}")
    return name


def take(argv, flags):
    """Split argv into {flag: value} for the flags that take a value, the bare flags found, and the rest."""
    vals, bare, rest, it = {}, set(), [], iter(argv)
    for a in it:
        if a in flags:
            vals[a] = next(it, None) or die(f"{a} needs a value")
        elif a in ("--check",):
            bare.add(a)
        else:
            rest.append(a)
    return vals, bare, rest


def target_dir(backend):
    return Path(os.environ.get("CARGO_TARGET_DIR") or f"target/{backend}")


def build(argv):
    vals, bare, rest = take(argv, ("--backend",))
    backend = choose(vals.get("--backend"))
    env = dict(os.environ)
    if "--check" in bare:
        # cargo trame sets the wrapper, the cfg and <target>/trame itself; the driver wants its own rustc
        cmd = ["cargo", "trame", "build"]
        if os.environ.get("TRAME_TOOLCHAIN"):
            env["PATH"] = os.environ["TRAME_TOOLCHAIN"] + ":" + env["PATH"]
    else:
        cmd = ["cargo", "build"]
        env["RUSTFLAGS"] = (env.get("RUSTFLAGS", "") + " --cfg trame_checked").strip()
    env["CARGO_TARGET_DIR"] = str(target_dir(backend))
    cmd += ["--release", "--no-default-features", "--features", backend] + rest
    os.execvpe(cmd[0], cmd, env)


def find(name, backend):
    """A path, or the newest bin or example called `name` under this backend's target dir (a checked build
    lives in <target>/trame)."""
    if "/" in name and Path(name).is_file():
        return str(Path(name).resolve())
    base = target_dir(backend)
    found = [p for d in (base, base / "trame") for prof in ("release", "debug") for sub in ("", "examples")
             if (p := d / prof / sub / name).is_file()]
    if not found:
        die(f"no program {name!r} under {base}; run 'trame build --backend {backend}' first")
    return str(max(found, key=lambda p: p.stat().st_mtime).resolve())


def run(argv):
    argv = list(argv)
    args = []
    if "--" in argv:
        k = argv.index("--")
        argv, args = argv[:k], argv[k + 1:]
    vals, _, rest = take(argv, ("--backend", "--split", "--bind", "--timeout", "--out"))
    if len(rest) != 1:
        die("usage: trame run [--backend NAME] [--split S] [--bind B] [--timeout T] [--out DIR] PROGRAM [-- ARGS]")
    backend = choose(vals.get("--backend"))
    binary = find(rest[0], backend)
    out = vals.get("--out") or tempfile.mkdtemp(prefix="trame-run-")
    cmd = [str(backends_dir() / backend / "launch"), "--out", out]
    for flag in ("--split", "--bind", "--timeout"):
        if flag in vals:
            cmd += [flag, vals[flag]]
    rc = subprocess.run(cmd + ["--", binary, *args]).returncode
    hosts = sorted(Path(out).glob("host*.out"), key=lambda p: int(p.stem[4:]))
    for p in hosts:
        sys.stdout.write(p.read_text(errors="replace"))
    sys.stdout.flush()
    for p in hosts:
        sys.stderr.write(p.with_suffix(".err").read_text(errors="replace") if p.with_suffix(".err").exists() else "")
    sys.exit(rc)


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in ("build", "run", "backends"):
        die("usage: trame backends|build|run ...")
    if sys.argv[1] == "backends":
        print("\n".join(backends()))
    else:
        (build if sys.argv[1] == "build" else run)(sys.argv[2:])
