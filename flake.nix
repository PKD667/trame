{
  description = "Backend-local trame development environments";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  # Nightly toolchains by date, for the driver only (see crates/driver/rust-toolchain.toml).
  inputs.rust-overlay = {
    url = "github:oxalica/rust-overlay";
    inputs.nixpkgs.follows = "nixpkgs";
  };
  # The lab experiments (nix/lab.nix, lab/README.md) and their deployment to hosts. Pinned; nixsci's only input is nixpkgs.
  # nixsci main (health check, target-side cache fetch, --hosts).
  inputs.nixsci = {
    url = "github:PKD667/nixsci/main";
    inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, rust-overlay, nixsci, ... }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs { inherit system; };
      lib = pkgs.lib;
      # Each piece is a file of nix/ and takes what it reads; nothing here names a backend.
      tc = import ./nix/toolchain.nix { inherit nixpkgs rust-overlay system; };
      tree = import ./nix/tree.nix { inherit pkgs; };
      build = import ./nix/build.nix { inherit pkgs nixsci system tree; };
      lab = import ./nix/lab.nix { inherit pkgs nixsci system self tree build manifest; };
      verdicts = import ./nix/checks.nix { inherit pkgs nixsci tree build tc; };
      manifest = import ./nix/manifest.nix { inherit pkgs self tree; };
      shells = import ./nix/shells.nix { inherit pkgs nixsci tree tc; };
      cli = import ./nix/cli.nix { inherit pkgs build; inherit (tc) driverToolchain trameDriver; };
    in {
      # `lib.<system>.backend NAME { checked ? true }`: what a program's flake takes of a backend (nix/export.nix).
      lib.${system}.backend = import ./nix/export.nix { inherit pkgs tree build; };
      validate.${system} = verdicts.suite;
      checks.${system} = verdicts.checks // {
        # The CI report: what each backend certifies and how it measures, in markdown with SVG figures, generated by
        # every CI run and committed nowhere. The numbers come from the nixsci analyses of the locked runs (a draft
        # analysis takes the runs that exist, and the report prints what it lacks); a clause without a row, a backend
        # without runs or a figure without data is printed as such, never skipped.
        ci-report = let
          tables = builtins.concatStringsSep " " (
            map (p: "--tables ${p}") (builtins.attrValues (builtins.removeAttrs lab.drafts [ "report" ]))
          );
          sources = pkgs.lib.fileset.toSource {
            root = ./.;
            fileset = pkgs.lib.fileset.unions [
              ./CONTRACT.md
              ./check/report.py
              (pkgs.lib.fileset.fileFilter (f: f.name == "guarantees.tsv" || f.name == "backend.nix") ./src/backends)
            ];
          };
        in
        pkgs.runCommand "trame-ci-report" { nativeBuildInputs = [ pkgs.python3 ]; } ''
          python3 ${sources}/check/report.py --root ${sources} --out $out --commit "''${TRAME_COMMIT:-path}" ${tables}
        '';
        lab-contract = lab.contract;
        lab-python = lab.python;
        # The backend part of Cargo.toml is what the descriptors say (nix/manifest.nix); `nix run .#manifest` rewrites it.
        manifest = pkgs.runCommand "manifest" { } ''
          diff -u ${./Cargo.toml} ${manifest.generated} && diff -u ${./rust-analyzer.toml} ${manifest.analyzer} \
            || { echo "Cargo.toml or rust-analyzer.toml is out of date: nix run .#manifest"; exit 1; }
          touch $out
        '';
        no-backend-names = import ./nix/names.nix { inherit pkgs self; inherit (tree) backendNames descriptors; };
      };
      packages.${system} = {
        trame = cli;
        trame-driver = tc.trameDriver;
      } // lab.packages // lib.concatMapAttrs (n: b: {
        "trame-${n}-bins" = b.bins;
        "launch-${n}" = b.launch;
      }) build.backends;
      # An analysis is a derivation over runs in lab.lock, which a fresh clone may not have, and `nix flake check`
      # evaluates packages: so the analyses are not under `packages` (nixsci's convention). One per experiment, named
      # for it, and `report` over all of them; `draft.<name>` takes the runs that exist.
      legacyPackages.${system} = lab.analyses // { draft = lab.drafts; };
      lab.${system} = {
        experiments = lab.runs;
        # The suite's jobs per backend: experiment, kind, machines of a job, and its jobs (sweep x seeds x replicates).
        suiteMatrix = lab.suite.matrix;
      };
      deployments.${system} = shells.deployments;
      apps.${system} = builtins.mapAttrs (_: e: e.run) lab.runs // {
        trame = { type = "app"; program = "${cli}/bin/trame"; };
        # Rewrites the backend part of Cargo.toml and rust-analyzer.toml from the descriptors, in the directory it is run from.
        manifest = { type = "app"; program = "${pkgs.writeShellScript "manifest" "install -m644 ${manifest.generated} Cargo.toml && install -m644 ${manifest.analyzer} rust-analyzer.toml"}"; };
        # Every experiment of the suite, for every backend (nix/lab/suite.nix), one after another.
        suite = lab.suite.app;
      };
      devShells.${system} = shells.devShells;
    };
}
